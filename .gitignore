# Ignore everything by default
*

# Do not ignore directories, so Git can search them for files
!*/

# Whitelist .cpp and .h files
!*.cpp
!*.h

# Whitelist HLSL shaders (and shared includes)
!*.hlsl
!*.HLSL
!*.hlsli
!*.HLSLI
/.claude
*.tlog

# Whitelist docs and README screenshots
!README.md
!docs/
!docs/**
